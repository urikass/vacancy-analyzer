# ==============================================================================
# Прозрачная вакансия (КАНТКОД — Регион 39)
# Скопируйте этот файл в .env и заполните нужные значения.
# НИКОГДА не загружайте файл .env с реальными ключами в Git!
# ==============================================================================

# --- Источник данных («Работа в России», Калининградская область — регион 39) ---
TRUDVSEM_API_URL=http://opendata.trudvsem.ru/api/v1/vacancies/region/39
MAX_VACANCIES=40
PAGE_SIZE=20
HTTP_TIMEOUT_SECONDS=20

# --- Расписание автоматического сбора ---
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_CRON="0 * * * *"

# --- Выбор провайдера ИИ ---
# Варианты:
#   gigachat — облачный GigaChat API (Сбер) + базовые правила
#   ollama   — локальная нейросеть через Ollama (бесплатно, без аккаунта) + базовые правила
#   rules    — только детерминированные правила (для быстрых автотестов без ИИ)
LLM_PROVIDER=ollama

# --- Настройки GigaChat API (получите ключ на developers.sber.ru) ---
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# В Windows/Linux при отсутствии сертификата Минцифры можно указать путь к .pem
# или выставить false только для локального теста (рекомендуется установить сертификат Минцифры)
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=

# --- Настройки локального запуска через Ollama (https://ollama.com) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Пути сохранения отчётов ---
OUTPUT_DIR=output
LAST_REPORT_PATH=output/latest_report.json
